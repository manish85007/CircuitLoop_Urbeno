# Copy to .env for local overrides. The app starts without this file.

PORT=43180
HOST=0.0.0.0
DATA_DIR=./data

# Railway: generate a long random string. Local fallback is compiled in.
SESSION_SECRET=change-me-in-railway

# Optional. Live Blancco lookups use this, then Masters → API key, then demo simulation.
BLANCCO_API_KEY=

# Comma-separated origins, or * for local.
CORS_ORIGINS=*
