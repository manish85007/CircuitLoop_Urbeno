# Copy to .env for local overrides. The app starts without this file.

PORT=43180
HOST=0.0.0.0
DATA_DIR=./data
BACKUP_DIR=./data/backups
BACKUP_ENABLED=1
# 18:30 UTC = 00:00 IST. Catch-up also runs ~20s after start if the last backup is older than 20h.
BACKUP_HOUR_UTC=18
BACKUP_MINUTE_UTC=30
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# Railway: generate a long random string. Local fallback is compiled in.
SESSION_SECRET=change-me-in-railway
# true behind HTTPS. Auto-on when DATA_DIR=/data (Railway).
COOKIE_SECURE=0

# Required for live Blancco lookups. Never stored in the register JSON.
BLANCCO_API_KEY=
BLANCCO_ENDPOINT=https://api.blancco.cloud/v1/erasure-reports

# Comma-separated origins. Production default is https://loop.urbeno.in
CORS_ORIGINS=http://127.0.0.1:43180,http://localhost:43180

# Optional shared secret required for first-time TOTP enroll (recommended in production).
BOOTSTRAP_TOKEN=

# --- Email OTP. Railway often blocks outbound SMTP (587/465); HTTPS APIs work. ---
# If SMTP_HOST is unset and no RESEND/SENDGRID/MAILGUN key, authenticator is the working factor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=circuitloop@urbeno.in
SMTP_STARTTLS=1
# SMTP_SSL=1
# SMTP_TIMEOUT=5
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
